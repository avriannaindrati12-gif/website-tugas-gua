<!DOCTYPE html>
<html lang="id">
<head>
    <!-- Pengaturan karakter & tampilan agar responsif -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Judul halaman yang muncul di tab browser -->
    <title>Layanan — ArchiDesign</title>
    
    <!-- Memuat library untuk styling dan ikon -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Konfigurasi warna dan font utama -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dark: '#0F172A',       /* Warna latar footer */
                        primary: '#1A1A2E',    /* Warna utama/navbar */
                        accent: '#C89563',     /* Warna penekan/emas */
                        light: '#F8F8F8',      /* Warna latar halaman */
                    },
                    fontFamily: {
                        display: ['Playfair Display', 'serif'],  /* Font judul */
                        sans: ['Inter', 'sans-serif'],           /* Font isi */
                    },
                }
            }
        }
    </script>
    
    <!-- Pengaturan animasi & perilaku tambahan -->
    <style>
        html { scroll-behavior: smooth; } /* Efek gulir halus */
        body { font-family: 'Inter', sans-serif; }
        .font-display { font-family: 'Playfair Display', serif; }
        .service-card { transition: all 0.3s ease; } /* Efek transisi kartu */
        .service-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.08); } /* Efek saat diarahkan kursor */
    </style>
</head>
<body class="bg-light text-gray-800">

    <!-- ==========================================
        NAVBAR — Menu Navigasi Atas
    ========================================== -->
    <nav class="fixed w-full z-50 bg-primary/95 py-4">
        <div class="container mx-auto px-6">
            <div class="flex justify-between items-center">
                <!-- Logo Website -->
                <a href="index.html" class="text-white text-2xl font-display font-bold">ARCHI<span class="text-accent">DESIGN</span></a>
                
                <!-- Menu untuk layar besar/desktop -->
                <div class="hidden md:flex items-center space-x-8">
                    <a href="index.html" class="text-white hover:text-accent">Beranda</a>
                    <a href="about.html" class="text-white hover:text-accent">Tentang</a>
                    <a href="services.html" class="text-accent">Layanan</a>
                    <a href="projects.html" class="text-white hover:text-accent">Proyek</a>
                    <a href="team.html" class="text-white hover:text-accent">Tim</a>
                    <a href="blog.html" class="text-white hover:text-accent">Blog</a>
                    <a href="contact.html" class="bg-accent text-white px-5 py-2 hover:bg-accent/90">Kontak</a>
                </div>
                
                <!-- Tombol menu untuk HP -->
                <button class="md:hidden text-white text-2xl">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- ==========================================
        HEADER HALAMAN
    ========================================== -->
    <section class="pt-36 pb-20 bg-primary text-white text-center">
        <div class="container mx-auto px-6">
            <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Layanan Kami</h1>
            <p class="text-gray-400">Beranda / Layanan Kami</p>
        </div>
    </section>

    <!-- ==========================================
        DAFTAR LAYANAN
    ========================================== -->
    <section class="py-24">
        <div class="container mx-auto px-6">
            <!-- Judul Bagian -->
            <div class="text-center mb-16">
                <span class="text-accent font-medium">Apa yang Kami Tawarkan</span>
                <h2 class="font-display text-3xl font-bold mt-2">Layanan Lengkap untuk Kebutuhan Bangunan Anda</h2>
            </div>

            <!-- Kotak Kartu Layanan -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <!-- KARTU 1: Desain Rumah Tinggal -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-home"></i> <!-- Ikon rumah -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Desain Rumah Tinggal</h3>
                    <p class="text-gray-600 mb-4">Perencanaan desain rumah dari konsep hingga gambar kerja lengkap</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

                <!-- KARTU 2: Desain Interior -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-couch"></i> <!-- Ikon sofa/interior -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Desain Interior</h3>
                    <p class="text-gray-600 mb-4">Tata letak ruang, pemilihan warna, furnitur, dan dekorasi yang sesuai gaya Anda</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

                <!-- KARTU 3: Desain Bangunan Komersial -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-building"></i> <!-- Ikon gedung -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Bangunan Komersial</h3>
                    <p class="text-gray-600 mb-4">Desain ruko, kantor, kafe, dan bangunan usaha yang fungsional & menarik</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

                <!-- KARTU 4: Konsultasi Arsitektur -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-comments"></i> <!-- Ikon obrolan -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Konsultasi Arsitektur</h3>
                    <p class="text-gray-600 mb-4">Diskusi ide, tinjauan lahan, dan saran teknis sebelum memulai pembangunan</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

                <!-- KARTU 5: Renovasi Bangunan -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-tools"></i> <!-- Ikon peralatan -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Renovasi & Perluasan</h3>
                    <p class="text-gray-600 mb-4">Mengubah tampilan atau menambah ruang pada bangunan yang sudah ada</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

                <!-- KARTU 6: Desain Lanskap -->
                <div class="bg-white p-8 shadow-sm service-card">
                    <div class="w-16 h-16 bg-accent/10 flex items-center justify-center text-accent text-2xl mb-6">
                        <i class="fas fa-mountain-sun"></i> <!-- Ikon taman -->
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Desain Lanskap & Taman</h3>
                    <p class="text-gray-600 mb-4">Perencanaan taman, halaman, dan area luar ruangan yang asri</p>
                    <a href="contact.html" class="text-accent hover:underline">Selengkapnya →</a>
                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================
        FOOTER — Bagian Bawah Halaman
    ========================================== -->
    <footer class="bg-dark text-white py-8 text-center">
        <p class="text-gray-500">&copy; 2026 ArchiDesign. Hak Cipta Dilindungi.</p>
    </footer>

</body>
</html>
